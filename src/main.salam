package main

import os

include cli "cli.salam"
include loader "loader.salam"
include tsv "tsv.salam"
include audit "audit.salam"
include report "report.salam"

func main:
    mut args := os.Args()
    defer args.free()
    if args.len() == 2 and args.get(1) == "--help":
        cli.Help()
        ret 0
    end
    if args.len() == 2 and args.get(1) == "--version":
        println "Civic Preflight 0.1.0"
        ret 0
    end
    if args.len() != 2:
        cli.Help()
        ret 2
    end
    mut read_ok := false
    mut lines := loader.Load(args.get(1), read_ok)
    defer lines.free()
    if not read_ok:
        println "ERROR: cannot read source (missing, >2 MiB, or invalid binary)"
        ret 2
    end
    if not tsv.HeaderOk(lines):
        println "ERROR: expected TSV header: reference, document_id, postal_code, appointment_date, email"
        ret 2
    end
    mut entries := tsv.Parse(lines)
    defer entries.free()
    counts := audit.Inspect(entries)
    report.Print(counts)
    if counts.problems == 0: ret 0 end
    ret 1
end
