package tsv

include model "model.salam"
include normalizer "normalizer.salam"

pub func HeaderOk(lines: Vector<str>): bool:
    if lines.len() == 0: ret false end
    mut parts := lines.get(0).split("\t")
    defer parts.free()
    if parts.len() != 5: ret false end
    ret normalizer.Trim(parts.get(0)) == "reference" and normalizer.Trim(parts.get(1)) == "document_id" and normalizer.Trim(parts.get(2)) == "postal_code" and normalizer.Trim(parts.get(3)) == "appointment_date" and normalizer.Trim(parts.get(4)) == "email"
end

pub func Parse(lines: Vector<str>): Vector<model.Entry>:
    mut entries := Vector {} as Vector<model.Entry>
    repeat lines.len() in i:
        if i == 0: continue end
        raw := lines.get(i)
        if normalizer.Trim(raw).len() == 0: continue end
        if raw.find("\t") < 0 and normalizer.Trim(raw).substr(0, 1) == "#": continue end
        mut columns := raw.split("\t")
        defer columns.free()
        mut entry := model.Entry { line = i + 1, fields = columns.len() }
        if columns.len() == 5:
            entry.reference = normalizer.Trim(columns.get(0))
            entry.document = normalizer.UpperAscii(normalizer.Trim(columns.get(1)))
            entry.postal = normalizer.Trim(columns.get(2))
            entry.appointment = normalizer.Trim(columns.get(3))
            entry.email = normalizer.Trim(columns.get(4))
        end
        entries.push(entry)
    end
    ret entries
end
